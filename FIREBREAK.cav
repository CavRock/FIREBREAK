RITUAL gen ;

  nr = 32
  nr HUNT
    nr + 1
    nc = 32
    nc HUNT
      nc + 1
      cnt = 0

      nc - 1
      nr - 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nc + 1
      nr + 1

      nr - 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nr + 1

      nc + 1
      nr - 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nc - 1
      nr + 1

      nc - 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nc + 1

      nc + 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nc - 1

      nc - 1
      nr + 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nc + 1
      nr - 1

      nr + 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nr - 1

      nc + 1
      nr + 1
      n
      fire get nc nr
      n HUNT
        n = 0
        cnt + 1
        n
      FIRE
      nc - 1
      nr - 1
      cur
      fire get nc nr

      k1 = 0
      cnt
      CLONE
      k1 + 1
      k2 = 3
      k3 = 4
      k1 HUNT
        k1 - 1
        k2 - 1
        k3 - 1
        k1
      FIRE

      eq2 = 1
      k2 HUNT
        eq2 = 0
        k2 = 0
        k2
      FIRE
      eq3 = 1
      k3 HUNT
        eq3 = 0
        k3 = 0
        k3
      FIRE

      out = 1
      eq3 HUNT
        out = 0
        eq3 = 0
        next set nc nr 1
        touched set nc nr 1
        eq3
      FIRE
      eq2 HUNT
        out = 0
        eq2 = 0
        next set nc nr cur
        eq2
      FIRE
      out HUNT
        out = 0
        next set nc nr 0
        cur HUNT
          cur = 0
          touched set nc nr 1
          cur
        FIRE
        out
      FIRE

      nc - 2
    FIRE
    nr - 2
  FIRE

  nr = 32
  nr HUNT
    nr + 1
    nc = 32
    nc HUNT
      nc + 1
      n
      next get nc nr
      n
      fire set nc nr n
      nc - 2
    FIRE
    nr - 2
  FIRE
END

RITUAL draw ;
  nr = 32
  nr HUNT
    nr + 1
    nc = 32
    nc HUNT
      nc + 1
      tf = 0
      af = 0
      sf = 1
      n = 0
      touched get nc nr
      n HUNT
        n = 0
        af = 1
        n = 0
        fire get nc nr
        n HUNT
          n = 0
          tf = 1
          af = 0
          n
        FIRE
        n
      FIRE
      tf HUNT
        tf = 0
        sf = 0
        nc - 2
        nr - 2
        pa
        PAINT "assets/fire.png" nc nr
        nc + 2
        nr + 2
        tf
      FIRE
      af HUNT
        af = 0
        sf = 0
        nc - 2
        nr - 2
        pa
        PAINT "assets/ash.png" nc nr
        nc + 2
        nr + 2
        af
      FIRE
      sf HUNT
        sf = 0
        nc - 2
        nr - 2
        pa
        PAINT "assets/tree.png" nc nr
        nc + 2
        nr + 2
        sf
      FIRE
      nc - 2
    FIRE
    nr - 2
  FIRE
END

RITUAL strike ;
  pa
  CLICK cx cy

pa HUNT

    px = 0
    py = 0
    cx
    CLONE
    px
    + 2
    cy
    CLONE
    py
    + 2
    pa
    struck = 1
    pa = 0
    pa
  FIRE
END

RITUAL apply ;
  df = 1
  bf = 0
  n
  fire get px py
  n HUNT
    n = 0
    bf = 1
    df = 0
    n
  FIRE
  pa
  bf HUNT
    bf = 0
    fire set px py 0
    touched set px py 1
    bf
  FIRE
  pa
  df HUNT
    df = 0
    fire set px py 1
    touched set px py 1
    df
  FIRE
END
RITUAL turn ;
  p1 = 0
  moved = 1
  moved HUNT
    p1 = 16
    NAP
    FLIP

    struck = 0
    strike
    moved = 1
    struck HUNT
      struck = 0
      moved = 0
      struck
    FIRE

    dead
    DRY
    dead HUNT
      dead = 0
      moved = 0
      shut = 1
      dead
    FIRE
    moved
  FIRE
END

RITUAL score ;
  t1 = 99
  t2 = 0
  t3 = 0
  t3
  sp get t1 t2
  t1 = 98
  bud
  sp get t1 t3
  nr = 32
  nr HUNT
    nr + 1
    nc = 32
    nc HUNT
      nc + 1
      n = 0
      touched get nc nr
      n HUNT
        n = 0
        bk = 0
        bk
        WHAT bud
        bk HUNT
          bk = 0
          bud - 1
          bk
        FIRE
        n
      FIRE
      nc - 2
    FIRE
    nr - 2
  FIRE
  t3 = 0
END
RITUAL blaze ;
  hot = 0
  nr = 32
  nr HUNT
    nr + 1
    nc = 32
    nc HUNT
      nc + 1
      c2 = 0
      c3 = 0
      n
      fire get nc nr
      n HUNT
        n = 0
        c2 = 1
        n
      FIRE
      n = 0
      touched get nc nr
      n HUNT
        n = 0
        c3 = 1
        n
      FIRE
      c2 HUNT
        c2 = 0
        c3 HUNT
          c3 = 0
          hot + 1
          c3
        FIRE
        c2
      FIRE
      nc - 2
    FIRE
    nr - 2
  FIRE
END

RITUAL pstar ;
  pa
  PAINT "assets/star.png" 0 31
END

RITUAL menu ;
  nr = 32
  nr HUNT
    nc = 32
    nc HUNT
      nc - 1
      nr - 1
      pa
      PAINT "assets/ash.png" nc nr
      nc + 1
      nr + 1
      nc - 1
    FIRE
    nr - 1
  FIRE

  pa
  PAINT "assets/d1.png" 2 0
  pa
  PAINT "assets/d2.png" 2 1
  pa
  PAINT "assets/d3.png" 2 2
  pa
  PAINT "assets/d4.png" 2 3
  pa
  PAINT "assets/d5.png" 2 4
  pa
  PAINT "assets/d6.png" 2 5
  pa
  PAINT "assets/d7.png" 2 6
  pa
  PAINT "assets/d8.png" 2 7
  pa
  PAINT "assets/d9.png" 2 8
  pa
  PAINT "assets/d0.png" 2 9
  pa
  PAINT "assets/star.png" 2 10
FLIP
END

RITUAL div16 ;
  dk = 16
  dq = 0

  dw = 0
  dw
  WHAT dv
  dw > dk < GEQ
  dw HUNT
    dv - 16
    dq + 1

    dw = 0
    dw
    WHAT dv
    dw > dk < GEQ
    dw
  FIRE
END

RITUAL wipe ;
  nr = 32
  nr HUNT
    nr + 1
    nc = 32
    nc HUNT
      nc + 1
      fire set nc nr 0
      touched set nc nr 0
      nc - 2
    FIRE
    nr - 2
  FIRE
END


RITUAL load ;
  t1 = 99
  t2 = 0
  sp set t1 t2 cy
  wipe
  t1 = 1
  nc
  sp get t1 cy
  t1 = 2
  nr
  sp get t1 cy
  nc HUNT
    fire set nc nr 1
    touched set nc nr 1
    t1 + 1
    nc
    sp get t1 cy
    t1 + 1
    nr
    sp get t1 cy
    nc
  FIRE
END

RITUAL lit ;
  fire set dq dv 1
  touched set dq dv 1
END

RITUAL loadend ;
  t1 = 99
  t2 = 0
  sp set t1 t2 11
  wipe
  rn2 = 0
  rn2
  WHAT rnd
  rn2 HUNT
    dv = 0
    BONE
    dw = 0
    dw
    WHAT dv
    dk = 85
    dw > dk < GEQ
    eq2 = 0
    WHEN dw
      dw = 0
      eq2 = 1
      dw
    END
    dw = 0
    dw
    WHAT dv
    dk = 170
    dw > dk < GEQ
    eq3 = 0
    WHEN dw
      dw = 0
      eq3 = 1
      dw
    END
    out = 1
    t2 = 0
    t3 = 0
    WHEN eq3
      t3 = 1
      out = 0
      eq2 = 0
      eq3 = 0
      eq3
    END
    WHEN eq2
      t2 = 1
      out = 0
      eq2 = 0
      eq2
    END
    dv = 0
    BONE
    div16
    t1 = 0
    dq
    sp get dq t1
    dv
    sp get dv t1
    WHEN out
      out = 0
      lit
      dq + 1
      lit
      dq - 2
      lit
      dq + 1
      out
    END
    WHEN t2
      t2 = 0
      dq + 1
      lit
      dq + 1
      dv + 1
      lit
      dv + 1
      dq - 2
      lit
      dq + 1
      lit
      dq + 1
      lit
      dq - 2
      dv - 2
      t2
    END
    WHEN t3
      t3 = 0
      dq + 1
      lit
      dq + 1
      lit
      dq - 2
      dv + 1
      lit
      dq + 1
      lit
      dv + 1
      lit
      dq - 1
      dv - 2
      t3
    END
    rn2 - 1
  FIRE
END
RITUAL reload ;
  t1 = 99
  t2 = 0
  cy
  sp get t1 t2
  qm = 1
  t3 = 0
  py = 0
  py
  WHAT cy
  py - 11
  WHEN py
    py = 0
    qm = 0
    t3 = 1
    py
  END
  WHEN qm
    qm = 0
    loadend
    qm
  END
  WHEN t3
    t3 = 0
    load
    t3
  END
END

RITUAL play ;
  gon = 0
  keep = 1
  keep HUNT
    shut = 0
    turn
    go = 1
    t3 = 1
    WHEN cx
      t3 = 0
      cx
    END
    cy - 31
    WHEN cy
      t3 = 0
      cy
    END
    WHEN t3
      keep = 0
      gon = 1
      go = 0
      t3
    END
    WHEN go
      apply
      gen
      blaze
      t3 = 1
      WHEN hot
        t3 = 0
        hot
      END
      WHEN t3
        score
        t2 = 1
        WHEN bud
          t2 = 0
          keep = 0
          bud
        END
        WHEN t2
          reload
          t2
        END
        t3
      END
      draw
      pstar
      go
    END
    WHEN shut
      keep = 0
      gon = 1
      shut
    END
    keep
  FIRE
END
RITUAL stone ;
  t3 = 1
  px = 0
  px
  WHAT cx
  px - 2
  px HUNT
    px = 0
    t3 = 0
    px
  FIRE
  pz = 11
  py = 0
  py
  WHAT cy
  py > pz < GEQ
  py HUNT
    py = 0
    t3 = 0
    py
  FIRE

  slack = 1
  t3 HUNT
    t3 = 0
    cy + 1
    slack = 0
    t3
  FIRE
  slack HUNT
    slack = 0
    cy = 0
    slack
  FIRE
END

RITUAL pick ;
  gon = 0
  qm = 1
  qm HUNT
    turn
    WHEN shut
      gon = 1
      shut = 0
      qm = 0
      shut
    END
    stone
    py = 0
    py
    WHAT cy
    WHEN py
      qm = 0
      py
    END
    qm
  FIRE
END
run = 1
run HUNT
  menu
  pick
  qm = 1
  WHEN gon
    qm = 0
    gon
  END
  WHEN qm
    py
    WHAT cy
    WHICH py
      11 =>
        rnd = 2
        more = 1
        more HUNT
          more = 0
          loadend
          draw
          pstar
          play
          t3 = 1
          WHEN gon
            t3 = 0
            gon = 0
            gon
          END
          WHEN t3
            more = 1
            rnd + 1
            t3
          END
          more
        FIRE
        score
      ELSE =>
        load
        draw
        pstar
        play
        score
    END
    qm
  END
  gon = 0
  turn
  shut = 0
  WHEN shut
    gon = 1
    shut
  END
  run = 1
  WHEN gon
    gon = 0
    run = 0
    gon
  END
  run
FIRE
